{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/generate-english.js": { "maxDuration": 60 }
  }
}
