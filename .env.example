# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password you choose yourself to access /admin.html. Use a long random value —
# treat it like a real password, it grants access to confirm orders and read codes.
ADMIN_SECRET=change-me-to-a-long-random-value

# Anthropic API key (console.anthropic.com > API Keys) — powers the AI-written
# CV/lettre generation. Billed per use; never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. sentry.io > Create Project (Node.js) > Client Keys (DSN). Without
# it, server-side errors are still logged to Vercel's Runtime Logs as before,
# just not sent anywhere proactively.
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
